.faq-page {
  min-height: 100vh;
}

.search-bar {
  background: linear-gradient(135deg, #fff5f0, #fff0e8);
  padding: 24rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}

.search-bar .link {
  color: #ff6b35;
  margin-left: 8rpx;
}

.category-bar {
  background: #fff;
  white-space: nowrap;
  padding: 0 16rpx;
  margin-bottom: 20rpx;
}

.category-list {
  display: flex;
  padding: 16rpx 0;
}

.category-item {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  margin: 0 8rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
}

.category-item.active {
  background: #ff6b35;
  color: #fff;
}

.faq-list {
  padding: 0 20rpx;
}

.faq-item {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.faq-question {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
}

.q-icon {
  width: 48rpx;
  height: 48rpx;
  background: #ff6b35;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.q-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.arrow {
  font-size: 28rpx;
  color: #ccc;
  transform: rotate(90deg);
  transition: transform 0.3s;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.arrow.expanded {
  transform: rotate(-90deg);
}

.faq-answer {
  display: flex;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s;
  padding: 0 24rpx;
}

.faq-answer.show {
  max-height: 1000rpx;
  padding: 0 24rpx 28rpx;
}

.a-icon {
  width: 48rpx;
  height: 48rpx;
  background: #07c160;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.a-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}
