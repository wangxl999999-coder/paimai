.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.seckill-header {
  background: linear-gradient(135deg, #ff4444, #ff6b35);
  padding: 30rpx;
}

.countdown-section {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.countdown-label {
  font-size: 28rpx;
  color: #fff;
}

.countdown-timer {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.time-block {
  background: rgba(0, 0, 0, 0.3);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  min-width: 60rpx;
  text-align: center;
}

.time-colon {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}

.banner-swiper {
  width: 100%;
  height: 500rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.goods-info {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.price-section {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.seckill-tag {
  padding: 6rpx 16rpx;
  background: #ff4444;
  color: #fff;
  font-size: 22rpx;
  border-radius: 6rpx;
}

.seckill-price {
  font-size: 52rpx;
  color: #ff4444;
  font-weight: bold;
}

.original-price {
  font-size: 26rpx;
  color: #999;
  text-decoration: line-through;
}

.discount {
  padding: 4rpx 12rpx;
  background: #fff3ee;
  color: #ff6b35;
  font-size: 22rpx;
  border-radius: 4rpx;
}

.goods-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.goods-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.stock-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stock-info {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.progress-bar {
  height: 20rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff9500, #ff4444);
  border-radius: 10rpx;
  transition: width 0.3s;
}

.stock-tip {
  font-size: 24rpx;
  color: #ff4444;
  text-align: right;
}

.rule-section {
  background: #fff;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.rule-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rule-item {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.price-info {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.label {
  font-size: 24rpx;
  color: #666;
}

.price {
  font-size: 40rpx;
  color: #ff4444;
  font-weight: bold;
}

.buy-btn {
  width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(90deg, #ff9500, #ff4444);
  color: #fff;
  font-size: 30rpx;
  border-radius: 40rpx;
  border: none;
}

.buy-btn.disabled {
  background: #ccc;
}
