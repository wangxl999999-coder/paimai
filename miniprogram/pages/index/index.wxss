.index-page {
  padding-bottom: 20rpx;
}

.search-bar {
  padding: 20rpx;
  background: #ff6b35;
}

.search-input {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-input .icon {
  margin-right: 12rpx;
}

.search-input .placeholder {
  color: #999;
  font-size: 26rpx;
}

.banner {
  height: 300rpx;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.categories {
  display: flex;
  background: #fff;
  padding: 30rpx 0;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
}

.category-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.category-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.category-name {
  font-size: 24rpx;
  color: #333;
}

.tabs {
  background: #fff;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.tab-list {
  display: flex;
  white-space: nowrap;
}

.tab-item {
  flex: 1;
  min-width: 120rpx;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #ff6b35;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #ff6b35;
  border-radius: 3rpx;
}

.goods-list {
  display: flex;
  flex-wrap: wrap;
  padding: 0 10rpx;
}

.goods-item {
  width: calc(50% - 20rpx);
  margin: 0 10rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.goods-image {
  position: relative;
  width: 100%;
  height: 320rpx;
}

.goods-image image {
  width: 100%;
  height: 100%;
}

.goods-type {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
}

.countdown {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
}

.goods-info {
  padding: 16rpx;
}

.goods-title {
  font-size: 28rpx;
  line-height: 1.4;
  height: 78rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 12rpx;
}

.goods-price {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.goods-price .price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b35;
}

.goods-price .original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 12rpx;
}

.goods-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.seller {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.seller .avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.seller-name {
  font-size: 22rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-stats {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
  margin-left: 8rpx;
}
