<view class="index-page">
  <view class="search-bar">
    <view class="search-input" bindtap="goSearch">
      <text class="icon">🔍</text>
      <text class="placeholder">搜索商品</text>
    </view>
  </view>

  <swiper class="banner" indicator-dots autoplay circular interval="3000" duration="500">
    <swiper-item wx:for="{{banners}}" wx:key="id" bindtap="onBannerClick" data-link="{{item.link}}">
      <image src="{{item.image}}" mode="aspectFill" class="banner-img"></image>
    </swiper-item>
  </swiper>

  <view class="categories">
    <view class="category-item" wx:for="{{categories}}" wx:key="id" bindtap="goCategory" data-id="{{item.id}}">
      <view class="category-icon" style="background: {{item.color}}">
        <text>{{item.icon}}</text>
      </view>
      <text class="category-name">{{item.name}}</text>
    </view>
  </view>

  <view class="tabs">
    <scroll-view scroll-x>
      <view class="tab-list">
        <view 
          class="tab-item {{activeTab === item.id ? 'active' : ''}}" 
          wx:for="{{tabs}}" 
          wx:key="id"
          bindtap="switchTab"
          data-id="{{item.id}}"
        >
          {{item.name}}
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="goods-list" wx:if="{{goodsList.length > 0}}">
    <view class="goods-item" wx:for="{{goodsList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="goods-image {{item.status === 'ended' ? 'ended' : ''}} {{item.stock === 0 ? 'sold-out' : ''}}">
        <image src="{{item.images[0]}}" mode="aspectFill"></image>
        <view class="goods-type tag tag-{{item.type}}">
          {{item.type === 'auction' ? '竞价' : item.type === 'fixed' ? '一口价' : item.type === 'group' ? '拼团' : '秒杀'}}
        </view>
        <view class="countdown" wx:if="{{item.countdown && !item.countdown.ended}}">
          <text>⏰ </text>
          <text>{{item.countdown.text}}</text>
        </view>
      </view>
      <view class="goods-info">
        <view class="goods-title">{{item.title}}</view>
        <view class="goods-price">
          <text class="price">{{item.currentPrice || item.price}}</text>
          <text class="original-price" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
        </view>
        <view class="goods-meta">
          <view class="seller" catchtap="goStore" data-id="{{item.seller.id}}">
            <image src="{{item.seller.avatar}}" class="avatar"></image>
            <text class="seller-name">{{item.seller.nickname}}</text>
          </view>
          <view class="goods-stats">
            <text wx:if="{{item.type === 'auction'}}">{{item.bidCount}}次出价</text>
            <text wx:elif="{{item.type === 'group'}}">{{item.joinedCount}}人已拼</text>
            <text wx:elif="{{item.type === 'seckill'}}">已抢{{item.soldCount}}件</text>
            <text wx:else>已售{{item.soldCount}}件</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{goodsList.length === 0 && !loading}}">
    <image src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=empty%20box&image_size=square"></image>
    <view>暂无商品</view>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>
