.welfare-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.welfare-header {
  position: relative;
  padding: 60rpx 32rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #ff9800, #ff6b35);
}

.header-content {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #fff;
}

.header-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

.goods-list {
  padding: 0 20rpx;
  display: flex;
  flex-wrap: wrap;
}

.goods-item {
  width: calc(50% - 10rpx);
  margin: 0 10rpx 20rpx 0;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.goods-item:nth-child(2n) {
  margin-right: 0;
}

.goods-image {
  position: relative;
  width: 100%;
  height: 300rpx;
}

.goods-image image {
  width: 100%;
  height: 100%;
}

.welfare-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: linear-gradient(135deg, #ff9800, #ff6b35);
  color: #fff;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: bold;
}

.countdown {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(244, 67, 54, 0.9);
  color: #fff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.goods-info {
  padding: 16rpx;
}

.goods-title {
  font-size: 28rpx;
  line-height: 1.4;
  height: 78rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 12rpx;
}

.goods-price {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.goods-price .label {
  font-size: 22rpx;
  color: #999;
}

.goods-price .price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b35;
}

.goods-price .current {
  font-size: 22rpx;
  color: #666;
  margin-left: 8rpx;
}

.goods-meta {
  font-size: 22rpx;
  color: #999;
}

.ended {
  opacity: 0.6;
}

.empty {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.tip-card {
  margin: 40rpx 20rpx 0;
  background: #fff9f5;
  border-radius: 16rpx;
  padding: 24rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6b35;
  margin-bottom: 16rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #666;
  line-height: 2;
}
