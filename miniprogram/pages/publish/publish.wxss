.publish-page {
  padding: 20rpx;
  min-height: 100vh;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  color: #333;
}

.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.type-item {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.type-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.type-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.type-desc {
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.back-btn {
  color: #ff6b35;
  font-size: 26rpx;
}

.current-type {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.form-item {
  margin-bottom: 32rpx;
}

.item-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.required {
  color: #f44336;
  margin-left: 4rpx;
}

.tip-text {
  font-size: 22rpx;
  color: #999;
  font-weight: normal;
  margin-left: 8rpx;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

.picker .arrow {
  color: #999;
}

.image-uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: calc(33.33% - 12rpx);
  padding-bottom: calc(33.33% - 12rpx);
  border-radius: 12rpx;
  overflow: hidden;
}

.image-item image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.remove-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 32rpx;
  line-height: 40rpx;
  text-align: center;
}

.upload-btn {
  width: calc(33.33% - 12rpx);
  padding-bottom: calc(33.33% - 12rpx);
  background: #f5f5f5;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.upload-btn .plus {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -80%);
  font-size: 48rpx;
  color: #ccc;
}

.upload-btn .upload-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, 50%);
  font-size: 22rpx;
  color: #999;
}

.tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

.step-price-list {
  margin-bottom: 16rpx;
}

.step-price-item {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}

.step-price-item text:first-child {
  font-size: 26rpx;
  color: #333;
  margin-right: 16rpx;
  width: 100rpx;
}

.step-input {
  flex: 1;
  height: 56rpx;
  background: #fff;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  margin-right: 8rpx;
}

.step-unit {
  font-size: 24rpx;
  color: #666;
  margin-right: 16rpx;
}

.remove-step {
  font-size: 36rpx;
  color: #999;
  padding: 0 8rpx;
}

.add-step-btn {
  color: #ff6b35;
  font-size: 26rpx;
  text-align: center;
  padding: 16rpx;
  background: #fff0e8;
  border-radius: 12rpx;
}

.submit-btn {
  margin-top: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
}

.step-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.modal-buttons .btn {
  flex: 1;
}
