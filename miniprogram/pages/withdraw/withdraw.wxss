.withdraw-page {
  min-height: 100vh;
  padding: 20rpx;
}

.amount-card {
  background: linear-gradient(135deg, #ff6b35, #ff8c5a);
  border-radius: 16rpx;
  padding: 40rpx;
  color: #fff;
  margin-bottom: 20rpx;
  position: relative;
}

.card-title {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.card-amount {
  font-size: 64rpx;
  font-weight: bold;
}

.all-btn {
  position: absolute;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.item-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.amount-input {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.symbol {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff6b35;
  margin-right: 12rpx;
}

.amount-input input {
  flex: 1;
  font-size: 40rpx;
  font-weight: bold;
}

.tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.type-list {
  display: flex;
  gap: 16rpx;
}

.type-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.type-item.active {
  background: #fff5f0;
  border-color: #ff6b35;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.type-name {
  font-size: 26rpx;
  color: #333;
}

.submit-btn {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
}

.records-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.records-card .card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-status {
  font-size: 26rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.record-status.pending {
  background: #fff3e0;
  color: #ff9800;
}

.record-status.approved,
.record-status.paid {
  background: #e8f5e9;
  color: #07c160;
}

.record-status.rejected,
.record-status.failed {
  background: #ffebee;
  color: #f44336;
}
