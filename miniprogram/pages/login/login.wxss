.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff5f0 0%, #fff 100%);
  padding: 80rpx 40rpx 40rpx;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
}

.login-tabs {
  display: flex;
  margin-bottom: 60rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 8rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: #fff;
  color: #ff6b35;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.wx-login {
  text-align: center;
}

.wx-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.wx-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 60rpx;
}

.wx-btn {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.item-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.phone-login .btn {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
}

.register-link {
  text-align: center;
  color: #ff6b35;
  font-size: 26rpx;
  margin-top: 32rpx;
}

.login-footer {
  position: fixed;
  bottom: 40rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.login-footer .link {
  color: #ff6b35;
  margin: 0 4rpx;
}
