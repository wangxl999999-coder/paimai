.store-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.store-header {
  position: relative;
  padding: 40rpx 32rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.store-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #ff6b35, #ff8c5a);
}

.store-info {
  position: relative;
  display: flex;
  align-items: center;
  z-index: 1;
}

.store-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 24rpx;
  background: #fff;
}

.store-detail {
  flex: 1;
  min-width: 0;
}

.store-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.verify-badge {
  width: 36rpx;
  height: 36rpx;
  background: #4caf50;
  color: #fff;
  border-radius: 50%;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.store-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-stats {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.store-stats text {
  margin-right: 24rpx;
}

.subscribe-btn {
  padding: 12rpx 32rpx;
  background: #fff;
  color: #ff6b35;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.subscribe-btn.subscribed {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-weight: normal;
}

.tabs {
  background: #fff;
  margin-bottom: 20rpx;
}

.tab-list {
  display: flex;
  white-space: nowrap;
}

.tab-item {
  flex: 1;
  min-width: 140rpx;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #ff6b35;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #ff6b35;
  border-radius: 3rpx;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 10rpx;
}

.goods-item {
  width: calc(50% - 20rpx);
  margin: 0 10rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.goods-image {
  position: relative;
  width: 100%;
  height: 320rpx;
}

.goods-image image {
  width: 100%;
  height: 100%;
}

.goods-type {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
}

.countdown {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(244, 67, 54, 0.9);
  color: #fff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.goods-info {
  padding: 16rpx;
}

.goods-title {
  font-size: 28rpx;
  line-height: 1.4;
  height: 78rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 12rpx;
}

.goods-price {
  margin-bottom: 8rpx;
}

.goods-price .price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b35;
}

.goods-meta {
  font-size: 22rpx;
  color: #999;
}

.ended {
  opacity: 0.6;
}

.sold-out::after {
  content: '已售罄';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(-30deg);
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  padding: 8rpx 32rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}
