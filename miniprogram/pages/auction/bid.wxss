.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.goods-info {
  background: #fff;
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.goods-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
}

.goods-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.price-info {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.label {
  font-size: 24rpx;
  color: #999;
}

.current-price {
  font-size: 40rpx;
  color: #ff6b35;
  font-weight: bold;
}

.countdown {
  font-size: 24rpx;
  color: #ff4444;
}

.bid-form {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.form-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.input-group {
  display: flex;
  align-items: center;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 20rpx;
}

.price-input {
  flex: 1;
  height: 80rpx;
  font-size: 32rpx;
  color: #333;
}

.price-unit {
  font-size: 28rpx;
  color: #666;
}

.bid-tip {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.quick-bid {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.quick-label {
  font-size: 26rpx;
  color: #666;
}

.quick-btns {
  display: flex;
  gap: 20rpx;
  flex: 1;
}

.quick-btn {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
  border: none;
  padding: 0;
}

.quick-btn::after {
  border: none;
}

.bid-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #ff6b35;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}

.bid-records {
  background: #fff;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-item:last-child {
  border-bottom: none;
}

.user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-nickname {
  font-size: 26rpx;
  color: #333;
}

.bid-time {
  font-size: 22rpx;
  color: #999;
}

.bid-amount {
  font-size: 30rpx;
  color: #ff6b35;
  font-weight: bold;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}
