.contact-page {
  min-height: 100vh;
  padding: 20rpx;
}

.contact-card, .feedback-card, .tip-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.contact-item:last-child {
  border-bottom: none;
}

.item-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  width: 60rpx;
  text-align: center;
}

.item-info {
  flex: 1;
}

.item-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.item-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.item-arrow {
  font-size: 26rpx;
  color: #ff6b35;
}

.form-item {
  margin-bottom: 32rpx;
}

.item-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.required {
  color: #f44336;
}

.textarea {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  min-height: 200rpx;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.image-uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: calc(33.33% - 12rpx);
  padding-bottom: calc(33.33% - 12rpx);
  border-radius: 12rpx;
  overflow: hidden;
}

.image-item image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.remove-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 32rpx;
  line-height: 40rpx;
  text-align: center;
}

.upload-btn {
  width: calc(33.33% - 12rpx);
  padding-bottom: calc(33.33% - 12rpx);
  background: #f5f5f5;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.upload-btn .plus {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -80%);
  font-size: 48rpx;
  color: #ccc;
}

.upload-btn .upload-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, 50%);
  font-size: 22rpx;
  color: #999;
}

.tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

.submit-btn {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
}

.tip-card {
  background: #fff9f5;
}

.tip-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6b35;
  margin-bottom: 16rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #666;
  line-height: 2;
}
