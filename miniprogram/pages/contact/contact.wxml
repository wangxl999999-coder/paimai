<view class="contact-page">
  <view class="contact-card">
    <view class="card-title">联系方式</view>
    <view class="contact-item" bindtap="callPhone">
      <view class="item-icon">📞</view>
      <view class="item-info">
        <view class="item-label">客服电话</view>
        <view class="item-value">{{servicePhone}}</view>
      </view>
      <view class="item-arrow">></view>
    </view>
    <view class="contact-item" bindtap="copyWechat">
      <view class="item-icon">💬</view>
      <view class="item-info">
        <view class="item-label">微信客服</view>
        <view class="item-value">{{serviceWechat}}</view>
      </view>
      <view class="item-arrow">点击复制</view>
    </view>
    <view class="contact-item">
      <view class="item-icon">🕒</view>
      <view class="item-info">
        <view class="item-label">服务时间</view>
        <view class="item-value">{{serviceTime}}</view>
      </view>
    </view>
  </view>

  <view class="feedback-card">
    <view class="card-title">意见反馈</view>
    <view class="form-item">
      <view class="item-label">问题描述 <text class="required">*</text></view>
      <textarea 
        class="textarea" 
        placeholder="请详细描述您遇到的问题或建议..."
        maxlength="500"
        value="{{message}}"
        bindinput="onInput"
      />
      <view class="char-count">{{message.length}}/500</view>
    </view>

    <view class="form-item">
      <view class="item-label">图片（可选）</view>
      <view class="image-uploader">
        <view class="image-item" wx:for="{{images}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill"></image>
          <view class="remove-btn" bindtap="removeImage" data-index="{{index}}">×</view>
        </view>
        <view class="upload-btn" bindtap="chooseImage" wx:if="{{images.length < 3}}">
          <text class="plus">+</text>
          <text class="upload-text">添加图片</text>
        </view>
      </view>
      <view class="tip">最多上传3张图片，帮助我们更好地了解问题</view>
    </view>

    <button class="btn btn-primary btn-block submit-btn" bindtap="submit" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交反馈'}}
    </button>
  </view>

  <view class="tip-card">
    <view class="tip-title">💡 温馨提示</view>
    <view class="tip-item">1. 紧急问题请直接拨打客服电话</view>
    <view class="tip-item">2. 提交反馈后我们将在24小时内处理</view>
    <view class="tip-item">3. 您也可以在"我的-消息"中查看回复</view>
  </view>
</view>
