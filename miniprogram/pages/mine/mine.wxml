<view class="mine-page">
  <view class="user-header">
    <view class="user-bg"></view>
    <view class="user-info" wx:if="{{userInfo}}" bindtap="goEditProfile">
      <image src="{{userInfo.avatar}}" class="avatar"></image>
      <view class="user-detail">
        <view class="user-name">
          {{userInfo.nickname}}
          <text class="verify-badge" wx:if="{{userInfo.isVerified}}">✓</text>
        </view>
        <view class="user-id">ID: {{userInfo.id}}</view>
      </view>
      <view class="edit-btn">编辑 ></view>
    </view>
    <view class="user-info" wx:else bindtap="goLogin">
      <view class="avatar-placeholder">👤</view>
      <view class="user-detail">
        <view class="user-name">点击登录</view>
        <view class="user-id">登录后查看更多功能</view>
      </view>
    </view>
  </view>

  <view class="stats-card" wx:if="{{userInfo}}">
    <view wx:if="{{statsError}}" style="text-align:center;color:#999;padding:30rpx 0;">获取统计失败，请下拉刷新重试</view>
    <view wx:else class="stats-row">
      <view class="stats-item" bindtap="goPage" data-url="/pages/participated/participated?tab=published">
        <text class="stats-value">{{stats.publishedCount}}</text>
        <text class="stats-label">发布</text>
      </view>
      <view class="stats-item" bindtap="goPage" data-url="/pages/participated/participated?tab=sold">
        <text class="stats-value">{{stats.soldCount}}</text>
        <text class="stats-label">卖出</text>
      </view>
      <view class="stats-item" bindtap="goPage" data-url="/pages/participated/participated?tab=purchased">
        <text class="stats-value">{{stats.purchasedCount}}</text>
        <text class="stats-label">买到</text>
      </view>
      <view class="stats-item">
        <text class="stats-value">¥{{stats.totalAmount || 0}}</text>
        <text class="stats-label">成交额</text>
      </view>
    </view>
    <view class="stats-row second-row" wx:if="{{!statsError}}">
      <view class="stats-item" bindtap="goCommission">
        <text class="stats-value text-primary">¥{{stats.commission || 0}}</text>
        <text class="stats-label">累计佣金</text>
      </view>
      <view class="stats-item" bindtap="goCommission">
        <text class="stats-value text-success">¥{{stats.availableCommission || 0}}</text>
        <text class="stats-label">可提现</text>
      </view>
      <view class="stats-item">
        <text class="stats-value">{{stats.fansCount || 0}}</text>
        <text class="stats-label">粉丝</text>
      </view>
      <view class="stats-item" bindtap="goPage" data-url="/pages/subscribe/subscribe">
        <text class="stats-value">{{stats.subscribeCount || 0}}</text>
        <text class="stats-label">订阅</text>
      </view>
    </view>
    <view class="commission-banner" bindtap="goCommission">
      <view class="banner-left">
        <text class="banner-icon">💰</text>
        <view class="banner-text">
          <view class="banner-title">帮卖赚佣金</view>
          <view class="banner-desc">分享商品，好友购买即可获佣金奖励</view>
        </view>
      </view>
      <view class="banner-arrow">去查看 ></view>
    </view>
  </view>

  <view class="menu-container" wx:if="{{userInfo}}">
    <view class="menu-group" wx:for="{{menuGroups}}" wx:for-item="group" wx:key="title">
      <view class="group-title">{{group.title}}</view>
      <view class="menu-list card">
        <view class="menu-item" wx:for="{{group.items}}" wx:for-item="item" wx:key="name" bindtap="goPage" data-url="{{item.url}}">
          <view class="item-left">
            <text class="item-icon">{{item.icon}}</text>
            <text class="item-name">{{item.name}}</text>
            <text class="badge" wx:if="{{item.badge}}">{{item.badge}}</text>
          </view>
          <text class="item-arrow">></text>
        </view>
      </view>
    </view>
  </view>

  <view class="action-buttons" wx:if="{{userInfo}}">
    <button class="btn btn-outline" open-type="share">
      分享我的店铺
    </button>
  </view>

  <view class="version">版本 v1.0.0</view>
</view>
