.commission-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.stats-header {
  position: relative;
  padding: 40rpx 32rpx 80rpx;
  overflow: hidden;
}

.stats-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #ff6b35, #ff8c5a);
}

.stats-content {
  position: relative;
  z-index: 1;
  text-align: center;
}

.stats-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 12rpx;
}

.stats-total {
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 30rpx;
}

.stats-row {
  display: flex;
  justify-content: center;
  gap: 80rpx;
  margin-bottom: 40rpx;
}

.stats-item {
  text-align: center;
}

.item-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.item-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.withdraw-btn {
  background: #fff;
  color: #ff6b35;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 60rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: bold;
  display: inline-block;
}

.tabs {
  display: flex;
  background: #fff;
  margin: -40rpx 20rpx 20rpx;
  border-radius: 16rpx;
  position: relative;
  z-index: 2;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #ff6b35;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #ff6b35;
  border-radius: 3rpx;
}

.commission-list {
  padding: 0 20rpx;
}

.commission-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.item-left {
  display: flex;
  flex: 1;
  min-width: 0;
}

.goods-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.item-status {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.item-status.available {
  background: #e8f5e9;
  color: #07c160;
}

.item-status.pending {
  background: #fff3e0;
  color: #ff9800;
}

.item-status.settled {
  background: #f5f5f5;
  color: #999;
}

.item-amount {
  font-size: 32rpx;
  font-weight: bold;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.tip-card {
  margin: 40rpx 20rpx 0;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 24rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #666;
  line-height: 2;
}
