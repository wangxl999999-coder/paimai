<view class="search-page">
  <view class="search-bar">
    <view class="search-input">
      <text class="icon">🔍</text>
      <input 
        placeholder="搜索商品" 
        value="{{keyword}}"
        bindinput="onInput"
        confirm-type="search"
        bindconfirm="search"
        focus
      />
      <text class="clear-btn" wx:if="{{keyword}}" bindtap="setData({keyword: '', list: [], searched: false})">×</text>
    </view>
    <text class="search-btn" bindtap="search">搜索</text>
  </view>

  <view class="search-suggest" wx:if="{{!searched}}">
    <view class="suggest-section" wx:if="{{history.length > 0}}">
      <view class="section-header">
        <text class="section-title">搜索历史</text>
        <text class="clear-btn" bindtap="clearHistory">清空</text>
      </view>
      <view class="tag-list">
        <view 
          class="tag-item" 
          wx:for="{{history}}" 
          wx:key="*this"
          bindtap="searchKeyword"
          data-keyword="{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>

    <view class="suggest-section">
      <view class="section-header">
        <text class="section-title">热门搜索</text>
      </view>
      <view class="tag-list">
        <view 
          class="tag-item hot" 
          wx:for="{{hotKeywords}}" 
          wx:key="*this"
          bindtap="searchKeyword"
          data-keyword="{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>
  </view>

  <view class="search-results" wx:if="{{searched}}">
    <view class="result-header">
      找到 {{list.length}} 个相关商品
    </view>

    <view class="goods-list" wx:if="{{list.length > 0}}">
      <view class="goods-item" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <image src="{{item.images[0]}}" class="goods-img" mode="aspectFill"></image>
        <view class="goods-info">
          <view class="goods-title">{{item.title}}</view>
          <view class="goods-price">
            <text class="price">{{item.currentPrice || item.price}}</text>
            <text class="original-price" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
          </view>
          <view class="goods-meta">
            <text class="tag tag-{{item.type}}">
              {{item.type === 'auction' ? '竞价' : item.type === 'fixed' ? '一口价' : item.type === 'group' ? '拼团' : '秒杀'}}
            </text>
            <text class="countdown" wx:if="{{item.countdown && !item.countdown.ended}}">
              ⏰ {{item.countdown.text}}
            </text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{list.length === 0 && !loading}}">
      <image src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=empty%20search&image_size=square"></image>
      <view>没有找到相关商品</view>
      <view class="empty-tip">试试其他关键词吧</view>
    </view>

    <view class="loading" wx:if="{{loading}}">加载中...</view>
  </view>
</view>
