page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.container {
  padding: 20rpx;
  box-sizing: border-box;
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.text-primary {
  color: #ff6b35;
}

.text-success {
  color: #07c160;
}

.text-danger {
  color: #f56c6c;
}

.text-muted {
  color: #999;
}

.text-sm {
  font-size: 24rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-xl {
  font-size: 36rpx;
  font-weight: bold;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  border: none;
  cursor: pointer;
}

.btn-primary {
  background: linear-gradient(135deg, #ff6b35, #ff8c5a);
  color: #fff;
}

.btn-success {
  background: linear-gradient(135deg, #07c160, #4ade80);
  color: #fff;
}

.btn-outline {
  background: #fff;
  color: #ff6b35;
  border: 2rpx solid #ff6b35;
}

.btn-block {
  width: 100%;
  display: flex;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.image {
  width: 100%;
  display: block;
  border-radius: 12rpx;
}

.price {
  color: #ff6b35;
  font-weight: bold;
}

.price::before {
  content: '¥';
  font-size: 0.8em;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}

.tag-auction {
  background: #fff0e8;
  color: #ff6b35;
}

.tag-fixed {
  background: #e8f5e9;
  color: #07c160;
}

.tag-group {
  background: #e3f2fd;
  color: #1976d2;
}

.tag-seckill {
  background: #ffebee;
  color: #f44336;
}

.tag-welfare {
  background: #fff3e0;
  color: #ff9800;
}

.empty {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
}

.empty image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.divider {
  height: 1rpx;
  background: #eee;
  margin: 20rpx 0;
}

.loading {
  padding: 40rpx;
  text-align: center;
  color: #999;
}

.countdown {
  display: inline-flex;
  align-items: center;
  background: #fff0f0;
  color: #f44336;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.countdown .num {
  background: #f44336;
  color: #fff;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin: 0 4rpx;
}

.sold-out {
  position: relative;
}

.sold-out::after {
  content: '已售罄';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(-30deg);
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  padding: 8rpx 32rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.ended {
  opacity: 0.6;
}

.input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.textarea {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  min-height: 200rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.row:last-child {
  border-bottom: none;
}

.row .label {
  width: 160rpx;
  color: #666;
}

.row .value {
  flex: 1;
  text-align: right;
  color: #333;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #f44336;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
}
